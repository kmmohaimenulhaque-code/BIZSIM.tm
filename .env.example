# ─────────────────────────────────────────────────────────────
#  BIZSIM settings
#  Server / Docker:  copy to  .env  in the project folder
#  Desktop app:      copy to  bizsim.env  in the app data folder
#    Linux:   ~/.config/bizsim/bizsim.env
#    macOS:   ~/Library/Application Support/bizsim/bizsim.env
#    Windows: %APPDATA%\bizsim\bizsim.env
#  Rules: KEY=value, no spaces around "=", lines starting with # are ignored.
#  Every setting is optional. Restart BIZSIM after editing.
# ─────────────────────────────────────────────────────────────

# Port for the web server (ignored by the desktop app)
PORT=8787

# ── AI case synthesis ────────────────────────────────────────
# Easiest: add keys in the app (Settings > AI keys). You can add several and
# BIZSIM falls back between them automatically.
# Here you can set one key per provider. If several are present the order is
# Anthropic, OpenAI-compatible, Gemini (or set LLM_PROVIDER to put one first).
# Free options: Gemini (https://aistudio.google.com/apikey),
# NVIDIA NIM (https://build.nvidia.com, keys start with nvapi-), Groq.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# A full fallback chain as JSON (optional). Each entry: provider, key, models.
# Providers: anthropic, openai, gemini, nvidia, groq, xai, openrouter, custom
# AI_KEYS=[{"provider":"nvidia","key":"nvapi-...","models":["z-ai/glm-5.3-flash","openai/gpt-oss-20b"]},{"provider":"gemini","key":"AIza...","models":[]}]

# Force a provider (optional): anthropic | openai | gemini | none
# LLM_PROVIDER=gemini

# Model names (optional).
# Gemini: leave GEMINI_MODEL empty and BIZSIM automatically picks the newest
# "flash" model your key can use, and switches if Google retires a model.
# Only set it to pin a specific model, e.g. gemini-3.8-flash
# GEMINI_MODEL=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible endpoints: OpenRouter, Groq, Together, or local Ollama
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama (no key needed)

# ── AI image generation ("Nano Banana") ──────────────────────
# Uses your Gemini (or OpenAI) key automatically. When this is off, season
# covers use each season's own Wikipedia image (free licences only).
# IMAGE_PROVIDER=gemini        # gemini | openai | none
# GEMINI_IMAGE_MODEL=          # empty = auto-pick newest flash-image model
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── SEC EDGAR (US company financials) ────────────────────────
# No key needed, the SEC only requires your name and email:
SEC_USER_AGENT=Your Name your@email.com

# ── Hosting (public web server only) ─────────────────────────
# Production: run behind an HTTPS reverse proxy (Nginx, Caddy, Cloudflare) with
# edge rate limits, supply AI keys above on the server, and set exact origins:
# CORS_ORIGINS=https://bizsim.example.com
# Set TRUST_PROXY to match your reverse proxy so per-IP rate limits see real client IPs:
#   loopback (default, local reverse proxy) | 1 (single cloud LB/CDN hop) | CIDR subnet
# TRUST_PROXY=1
# Optional locked-down public AI gate: when set, expensive AI routes return 401 unless X-BizSim-Public-Token
# (or Authorization: Bearer) is injected by an authenticating reverse proxy (e.g. Cloudflare Access / OAuth2 Proxy).
# NEVER put this token in VITE_* or client code. Leave empty on desktop/local builds.
# BIZSIM_PUBLIC_AI_TOKEN=
# Where generated images are stored
# BIZSIM_DATA_DIR=./server/data
